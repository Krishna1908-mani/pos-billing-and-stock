PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# Supabase PostgreSQL Configuration (Session Pooler - Port 5432)
DATABASE_URL=postgresql://postgres.bxaaejvtpswezmgywnub:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_SSL_CA_PATH=certs/supabase-ca-bundle.pem

# Security (512-bit JWT Signing Secret)
JWT_SECRET=your_rotated_512_bit_jwt_secret_here
JWT_EXPIRES_IN=7d

# Standby Legacy Datastore (Optional, Non-fatal)
MONGODB_URI=mongodb://127.0.0.1:27017/stockwise
